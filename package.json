{
  "name": "speclift",
  "version": "2.0.1",
  "description": "Private, browser-only Swagger 2.0 to OpenAPI 3 converter with Swagger's conversion rules, minus Swagger's bugs.",
  "keywords": [
    "swagger",
    "openapi",
    "openapi3",
    "swagger2",
    "converter",
    "api",
    "yaml",
    "privacy"
  ],
  "homepage": "https://speclift.coderator.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dante0747/spec-lift.git"
  },
  "bugs": {
    "url": "https://github.com/dante0747/spec-lift/issues"
  },
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "build:pages": "node scripts/build-pages.mjs",
    "start": "vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs tests/converter-refs.test.mjs tests/converter.test.mjs tests/parity.test.mjs tests/parity-yaml.test.mjs tests/fixed-mode.test.mjs tests/oas3-validity.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "parity:check": "node scripts/parity-check.mjs tests/fixtures/parity",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "js-yaml": "5.5.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/js-yaml": "4.0.9",
    "@types/node": "22.19.19",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "ajv": "8.20.0",
    "ajv-draft-04": "1.0.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.1.5",
    "wrangler": "4.92.0"
  }
}
