{
  "openapi": "3.0.1",
  "info": {
    "title": "Responses",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/a": {
      "get": {
        "responses": {
          "200": {
            "description": "With headers",
            "headers": {
              "X-Ext": {
                "schema": {
                  "type": "string",
                  "x-header-ext": 1
                }
              },
              "X-Rate-Limit": {
                "description": "calls per hour",
                "schema": {
                  "type": "integer",
                  "format": "int32"
                }
              },
              "X-Expires": {
                "schema": {
                  "type": "string",
                  "format": "date-time"
                }
              },
              "X-List": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Thing"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/Thing"
                }
              }
            }
          },
          "201": {
            "description": "With examples",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "id": 1
                }
              },
              "application/xml": {
                "schema": {
                  "type": "object"
                },
                "example": "<id>1</id>"
              }
            }
          },
          "202": {
            "description": "No schema",
            "content": {}
          },
          "203": {
            "description": "Examples without schema",
            "content": {
              "application/json": {
                "example": {
                  "a": 1
                }
              }
            }
          },
          "400": {
            "description": "Bad",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "x-resp-ext": "r"
          }
        }
      }
    },
    "/file": {
      "get": {
        "responses": {
          "200": {
            "description": "File",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          }
        }
      }
    },
    "/override": {
      "get": {
        "responses": {
          "200": {
            "description": "csv",
            "content": {
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "headers": {
              "X-Why": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {}
          }
        }
      }
    },
    "/arr": {
      "get": {
        "responses": {
          "200": {
            "description": "arr",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Thing"
                  }
                }
              },
              "application/xml": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Thing"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Thing": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          }
        }
      },
      "Error": {
        "required": [
          "code"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "format": "int32"
          },
          "message": {
            "type": "string"
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Bad",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          },
          "application/xml": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NotFound": {
        "description": "Not found",
        "headers": {
          "X-Why": {
            "schema": {
              "type": "string"
            }
          }
        },
        "content": {}
      },
      "Example": {
        "description": "Example",
        "content": {
          "application/json": {
            "schema": {
              "type": "string"
            },
            "example": "hi"
          },
          "application/xml": {
            "schema": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "x-original-swagger-version": "2.0"
}
